    uint32    dwExStyle,
    char*     lpClassName,
    char*     lpWindowName,
    uint32    dwStyle,
    int32     X,
    int32     Y,
    int32     nWidth,
    int32     nHeight,
    HWND      hWndParent,
    HMENU     hMenu,
    HINSTANCE hInstance,
    void*     lpParam);

bool32 DestroyWindow(HWND hWnd);

bool32 ShowWindow(HWND hWnd, int32 nCmdShow);
bool32 AnimateWindow(HWND hWnd, uint32 dwTime, uint32 dwFlags);

bool32 UpdateWindow(HWND hWnd);


bool32 IsZoomed(HWND hWnd);
bool32 IsIconic(HWND hWnd);


int32 GetWindowLongA(HWND hWnd, int32 nIndex);
int64 GetWindowLongPtrA(HWND hWnd, int32 nIndex);
int32 SetWindowLongA(HWND hWnd, int32 nIndex, int32 NewLong);
int64 SetWindowLongPtrA(HWND hWnd, int32 nIndex, int64 NewLong);

struct MSG {
    HWND     hwnd;
    uint32   message;
    uint64   wParam;
    int64    lParam;
    uint32   time;
    ivec2    pt;
// #ifdef _MAC
    uint32   lPrivate;
// #endif
}

bool32 GetMessageA(MSG* msg, HWND hWnd, uint32 wMsgFilterMin, uint32 wMsgFilterMax);
bool32 PeekMessageA(MSG* msg, HWND hWnd, uint32 wMsgFilterMin, uint32 wMsgFilterMax, uint32 wRemoveMsg);
bool32 TranslateMessage(MSG* msg);
int64 DispatchMessageA(MSG* msg);

int64 DefWindowProcA(HWND hWnd, uint32 msg, uint64 wParam, int64 lParam);

type HDC = void*;
HDC GetDC(HWND hWnd);

struct PIXEL_FORMAT_DESCRIPTOR {
    uint16  nSize;
    uint16  nVersion;
    uint32  dwFlags;
    byte    iPixelType;
    byte    cColorBits;
    byte    cRedBits;
    byte    cRedShift;
    byte    cGreenBits;
    byte    cGreenShift;
    byte    cBlueBits;
    byte    cBlueShift;
    byte    cAlphaBits;
    byte    cAlphaShift;
    byte    cAccumBits;
    byte    cAccumRedBits;
    byte    cAccumGreenBits;
    byte    cAccumBlueBits;
    byte    cAccumAlphaBits;
    byte    cDepthBits;
    byte    cStencilBits;
    byte    cAuxBuffers;
    byte    iLayerType;
    byte    bReserved;
    uint32  dwLayerMask;
    uint32  dwVisibleMask;
    uint32  dwDamageMask;
}

// pixel types
const PFD_TYPE_RGBA             = 0;
const PFD_TYPE_COLORINDEX       = 1;

// layer types
const PFD_MAIN_PLANE            = 0;
const PFD_OVERLAY_PLANE         = 1;
const PFD_UNDERLAY_PLANE        = -1;

// PIXEL_FORMAT_DESCRIPTOR flags
const PFD_DOUBLEBUFFER          = 0x00000001;
const PFD_STEREO                = 0x00000002;
const PFD_DRAW_TO_WINDOW        = 0x00000004;
const PFD_DRAW_TO_BITMAP        = 0x00000008;
const PFD_SUPPORT_GDI           = 0x00000010;
const PFD_SUPPORT_OPENGL        = 0x00000020;
const PFD_GENERIC_FORMAT        = 0x00000040;
const PFD_NEED_PALETTE          = 0x00000080;
const PFD_NEED_SYSTEM_PALETTE   = 0x00000100;
const PFD_SWAP_EXCHANGE         = 0x00000200;
const PFD_SWAP_COPY             = 0x00000400;
const PFD_SWAP_LAYER_BUFFERS    = 0x00000800;
const PFD_GENERIC_ACCELERATED   = 0x00001000;
const PFD_SUPPORT_DIRECTDRAW    = 0x00002000;
const PFD_DIRECT3D_ACCELERATED  = 0x00004000;
const PFD_SUPPORT_COMPOSITION   = 0x00008000;


int32    ChoosePixelFormat(HDC hdc, PIXEL_FORMAT_DESCRIPTOR* ppfd);
bool32   SetPixelFormat(HDC hdc, int32 format, PIXEL_FORMAT_DESCRIPTOR* ppfd);

