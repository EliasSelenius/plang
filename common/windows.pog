struct WNDCLASSEXA {
    uint32        cbSize;
    // Win 3.x
    uint32        style;
    WNDPROC       lpfnWndProc;
    int32         cbClsExtra;
    int32         cbWndExtra;
    HINSTANCE     hInstance;
    HICON         hIcon;
    HCURSOR       hCursor;
    HBRUSH        hbrBackground;
    char*         lpszMenuName;
    char*         lpszClassName;
    // Win 4.0
    HICON         hIconSm;
}

