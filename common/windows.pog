


type HANDLE = void*;
const INVALID_HANDLE_VALUE = -1 as HANDLE;

bool32 CloseHandle(HANDLE hObject);


struct FILETIME {
    uint32 dwLowDateTime;
    uint32 dwHighDateTime;
}

struct WIN32_FIND_DATAW {
    uint32 dwFileAttributes;
    FILETIME ftCreationTime;
    FILETIME ftLastAccessTime;
    FILETIME ftLastWriteTime;
    uint32 nFileSizeHigh;
    uint32 nFileSizeLow;
    uint32 dwReserved0;
    uint32 dwReserved1;
    uint16[260] cFileName;
    uint16[14] cAlternateFileName;
}

struct WIN32_FIND_DATAA {
    uint32 dwFileAttributes;
    FILETIME ftCreationTime;
    FILETIME ftLastAccessTime;
    FILETIME ftLastWriteTime;
    uint32 nFileSizeHigh;
    uint32 nFileSizeLow;
    uint32 dwReserved0;
    uint32 dwReserved1;
    char[260] cFileName;
    char[14] cAlternateFileName;
}


const FILE_ATTRIBUTE_DIRECTORY = 0x00000010;

int32 FindClose(HANDLE hFindFile);
HANDLE FindFirstFileA(char* lpFileName, WIN32_FIND_DATAA* lpFindFileData);
int32 FindNextFileA(HANDLE hFindFile, WIN32_FIND_DATAA* lpFindFileData);

const MAX_PATH = 260;

uint32 GetFullPathNameA(char* lpFileName, uint32 nBufferLength, char* lpBuffer, char** lpFilePart);
bool SetCurrentDirectoryA(char* lpPathName); // if returns false call GetLastError()
uint32 GetCurrentDirectoryA(uint32 nBufferLength, char* lpBuffer);

char* PathCombineA(char* pszDest, pszDir, pszFile);


uint32 GetLastError();

const ERROR_SUCCESS = 0;
const ERROR_FILE_NOT_FOUND = 2;
const ERROR_PATH_NOT_FOUND = 3;



void* VirtualAlloc(void* lpAddress, uint64 dwSize, uint32 flAllocationType, uint32 flProtect);
int32 VirtualFree(void* lpAddress, uint64 dwSize, uint32 dwFreeType);

const MEM_COMMIT   = 0x00001000;
const MEM_RESERVE  = 0x00002000;
const MEM_DECOMMIT = 0x00004000;
const MEM_RELEASE  = 0x00008000;

const PAGE_NOACCESS          = 0x01;
const PAGE_READWRITE         = 0x04;
const PAGE_EXECUTE_READWRITE = 0x40;






struct Win32_Security_Attributes {
    uint32 nLength;
    void* lpSecurityDescriptor;
    bool32 bInheritHandle;
}

HANDLE CreateThread(
    Win32_Security_Attributes*  lpThreadAttributes,
    uint64                      dwStackSize,
    uint32(void*)               lpStartAddress,
    void*                       lpParameter,
    uint32                      dwCreationFlags,
    uint32*                     lpThreadId);

uint32 SuspendThread(HANDLE hThread);
uint32 ResumeThread(HANDLE hThread);
HANDLE GetCurrentThread();





type HWND       = void*;
type HMENU      = void*;
type HINSTANCE  = void*;
type HMODULE    = HINSTANCE;


type HICON      = void*;
type HCURSOR    = void*;
type HBRUSH     = void*;


HCURSOR LoadCursorA(HINSTANCE hInstance, char* lpCursorName);

type ATOM = uint16;

type WNDPROC = int64(HWND, uint32, uint64, int64);

struct WNDCLASSEXA {
    uint32        cbSize;
    // Win 3.x
    uint32        style;
    WNDPROC       lpfnWndProc;
    int32         cbClsExtra;
    int32         cbWndExtra;
    HINSTANCE     hInstance;
    HICON         hIcon;
    HCURSOR       hCursor;
    HBRUSH        hbrBackground;
    char*         lpszMenuName;
    char*         lpszClassName;
    // Win 4.0
    HICON         hIconSm;
}

ATOM RegisterClassExA(WNDCLASSEXA* wnd_class_ex);
bool32 UnregisterClassA(char* lpClassName, HINSTANCE hInstance);

HWND CreateWindowExA(
    uint32    dwExStyle,
    char*     lpClassName,
    char*     lpWindowName,
    uint32    dwStyle,
    int32     X,
    int32     Y,
    int32     nWidth,
    int32     nHeight,
    HWND      hWndParent,
    HMENU     hMenu,
    HINSTANCE hInstance,
    void*     lpParam);

bool32 DestroyWindow(HWND hWnd);

bool32 ShowWindow(HWND hWnd, int32 nCmdShow);
bool32 AnimateWindow(HWND hWnd, uint32 dwTime, uint32 dwFlags);

bool32 UpdateWindow(HWND hWnd);

type POINT = ivec2;

struct MSG {
    HWND     hwnd;
    uint32   message;
    uint64   wParam;
    int64    lParam;
    uint32   time;
    POINT    pt;
// #ifdef _MAC
    uint32   lPrivate;
// #endif
}

bool32 GetMessageA(MSG* lpMsg, HWND hWnd, uint32 wMsgFilterMin, uint32 wMsgFilterMax);
bool32 TranslateMessage(MSG* lpMsg);
int64 DispatchMessageA(MSG* lpMsg);

int64 DefWindowProcA(HWND hWnd, uint32 Msg, uint64 wParam, int64 lParam);


type proc = int64();
// libloaderapi.h
HMODULE GetModuleHandleA(char* ModuleName);
proc GetProcAddress(HMODULE hModule, char* ProcName);





// Implementation of platform agnostic API:

void* vmem_reserve(uint64 size)                { return VirtualAlloc(null,    size, MEM_RESERVE, PAGE_NOACCESS);  }
void vmem_release(void* address)               {        VirtualFree (address, 0,    MEM_RELEASE);                 }
void vmem_commit(void* address, uint64 size)   {        VirtualAlloc(address, size, MEM_COMMIT,  PAGE_READWRITE); }
void vmem_decommit(void* address, uint64 size) {        VirtualFree (address, size, MEM_DECOMMIT);                }

void debug_break() {
    void DebugBreak();
    DebugBreak();
}
