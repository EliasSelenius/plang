

const ListStartingCapacity = 2;

struct List {
    uint32 stride;
    uint32 capacity;
    uint32 length;
}

void[..] list_create(uint32 stride) return list_create(stride, ListStartingCapacity);
void[..] list_create(uint32 stride, starting_capacity) {
    List* head = malloc(sizeof List + stride * starting_capacity);
    head.stride = stride;
    head.capacity = starting_capacity;
    head.length = 0;
    return *head[1] as void[..];
}

List* list_head(void[..] list) { return *(list as List*)[-1]; }
uint32 list_length(void[..] list) { return list ? list_head(list).length : 0; }
uint32 list_capacity(void[..] list) { return list_head(list).capacity; }
uint32 list_stride(void[..] list) { return list_head(list).stride; }

void list_set_length(void[..] list, uint32 new_len) { list_head(list).length = new_len; }
void list_delete(void[..] list) { free(list_head(list)); }
void list_clear(void[..] list) { if list list_head(list).length = 0; }

bool list_out_of_bounds(void[..] list, uint32 it) return it >= list_length(list);
bool list_out_of_bounds(void[..] list, int32 it) return it<0  or  it as uint32 >= list_length(list);

void[] as_span(void[..] list) {
    void[] span;
    span.data = list as void*;
    span.length = list_length(list);
    return span;
}

void[] make_span(void* data, uint32 len) {
    void[] span;
    span.data   = data;
    span.length = len;
    return span;
}

void list_realloc(void[..]* list, uint32 new_capacity) {
    List* head = list_head(@list);

    head.capacity = new_capacity;
    head = realloc(head, sizeof List + head.capacity * head.stride);
    @list = *head[1] as void[..];
}

void* list_add(void[..]* list, void* data) {
    let len = list_length(@list);
    let cap = list_capacity(@list);
    let stride = list_stride(@list);

    if cap == len  list_realloc(list, cap * 2);

    void* dst = (@list as byte*) + len * stride;
    if data  memcpy(dst, data, stride);

    list_set_length(@list, len + 1);
    return dst;
}

void* list_add(void[..]* list) return list_add(list, null);
void* list_append(void[..]* list) { return list_add(list, null); }
void* list_append(void[..]* list, uint32 count) {
    void* ret = list_add(list, null);
    for 1 .. count  list_add(list, null);
    return ret;
}

void* list_get(void[..] list, int32 index) { return (list as byte*) + (list_stride(list) as int32) * index; }
void* list_get(void[..] list, uint32 index) { return (list as byte*) + list_stride(list) * index; }
void* list_last_item(void[..] list) { return list_get(list, list_length(list) - 1); }

void list_swap(void[..] list, uint32 i, j) {
    swap(list_stride(list), list_get(list, i), list_get(list, j));
}

int32 index_of(void[..] list, void* data) {
    let len = list_length(list);
    for 0 .. len {
        void* item = list_get(list, it);
        if memcmp(data, item, list_stride(list)) == 0 return it;
    }

    return -1;
}

void list_remove(void[..] list, void* item) {
    int32 i = index_of(list, item);
    if i != -1 {
        list_unordered_remove(list, i as uint32);
    }
}

void list_unordered_remove(void[..] list, uint32 index) {
    let len = list_length(list);
    memcpy(list_get(list, index), list_get(list, len - 1), list_stride(list));
    list_set_length(list, len - 1);
}

void list_ordered_remove(void[..] list, uint32 index) {
    let new_len = list_length(list) - 1;
    memmove(list_get(list, index), list_get(list, index + 1), (new_len - index) * list_stride(list));
    list_set_length(list, new_len);
}

void* list_insert(void[..]* list, uint32 index) { return list_insert(list, index, null); }
void* list_insert(void[..]* list, uint32 index, void* data) {
    let stride = list_stride(@list);
    let count = list_length(@list) - index;

    list_append(list);
    void* item = list_get(@list, index);
    memmove(list_get(@list, index + 1), item, count * stride);
    if data memcpy(item, data, stride);

    return item;
}

void* list_pop(void[..] list) {
    uint32 len = list_length(list);
    if len == 0 return null;

    void* res = list_get(list, len - 1);
    list_set_length(list, len - 1);
    return res;
}


type Heap_Compare = bool(void[..], uint32, uint32);

bool int32_minheap(int32[..] heap, uint32 l, r) {
    return heap[l] < heap[r];
}

bool float32_minheap(float[..] heap, uint32 l, r) {
    return heap[l] < heap[r];
}

void heapify_up(void[..] heap, uint32 i, Heap_Compare compare) {
    uint32 p = (i-1)/2;
    while i and compare(heap, i, p) {
        list_swap(heap, i, p);
        i = p;
        p = (i-1)/2
    }
}

void heap_insert(void[..]* heap, void* data, Heap_Compare compare) {
    uint32 index = list_length(heap);
    list_add(heap, data);
    heapify_up(@heap, index, compare);
}

void heapify_down(void[..] heap, uint32 index, Heap_Compare compare) {
    uint32 len = list_length(heap);

    while true {
        uint32 il = index*2 + 1;
        uint32 ir = index*2 + 2;

        uint32 small = index;
        if il < len and compare(heap, il, small)   small = il;
        if ir < len and compare(heap, ir, small)   small = ir;

        if small == index  break;

        list_swap(heap, index, small);
        index = small;
    }
}

bool heap_extract(void[..] heap, Heap_Compare compare, void* out_value) {
    void* last = list_pop(heap);
    if last == null  return false;

    uint32 stride = list_stride(heap)
    if out_value    memmove(out_value, heap, stride);
    memmove(heap, last, stride);

    heapify_down(heap, 0, compare);
    return true;
}

void heap_test() {
    int32[..] heap = list_create(sizeof int32);

    for 0 .. 10 {
        int32 r = (random01() * 100.0) as int32;
        print(r, ", ");
        heap_insert(*heap, *r, int32_minheap);
    }
    print("\n");


    uint32 len = list_length(heap);
    for 0 .. len {
        print(heap[it], ", ");
    }
    print("\n");


    int32 value = 0;
    while heap_extract(heap, int32_minheap, *value) {
        print(value, ", ");
    }
    print("\n");

}

struct Graph {
    Graph_Node[..] nodes;
    Graph_Edge[..] edges;
}

struct Graph_Node {
    uint32 start_edge;
    uint32 edges;
}

struct Graph_Edge {
    uint32 node;
    float dist;
}

void add_node(Graph* g) {
    Graph_Node* n = list_add(*g.nodes);
    uint32 start = list_length(g.edges);
    @n = {start, 0};
}

void add_edge(Graph* g, uint32 node, float dist) {
    Graph_Edge e = {node, dist};
    list_add(*g.edges, *e);

    Graph_Node* n = list_last_item(g.nodes);
    n.edges++;
}

void dijkstra_test() {
    Graph g = {};
    g.nodes = list_create(sizeof Graph_Node);
    g.edges = list_create(sizeof Graph_Edge);

    const A = 0;
    const B = 1;
    const C = 2;
    const D = 3;
    const E = 4;
    const F = 5;
    const G = 6;


    add_node(*g); // A
    add_edge(*g, B, 20);
    add_edge(*g, C, 45);
    add_edge(*g, D, 102);

    add_node(*g); // B
    add_edge(*g, A, 20);
    add_edge(*g, D, 85);
    add_edge(*g, E, 79);

    add_node(*g); // C
    add_edge(*g, F, 15);
    add_edge(*g, A, 45);
    add_edge(*g, D, 55);

    add_node(*g); // D
    add_edge(*g, A, 102);
    add_edge(*g, B, 85);
    add_edge(*g, C, 55);
    add_edge(*g, E, 4);
    add_edge(*g, F, 55);
    add_edge(*g, G, 12);

    add_node(*g); // E
    add_edge(*g, B, 79);
    add_edge(*g, D, 4);
    add_edge(*g, G, 5);

    add_node(*g); // F
    add_edge(*g, C, 15);
    add_edge(*g, D, 55);
    add_edge(*g, G, 32);

    add_node(*g); // G
    add_edge(*g, D, 12);
    add_edge(*g, E, 5);
    add_edge(*g, F, 32);

    float[] dists = dijkstra(*g);

    for 0 .. dists.length {
        print(dists[it], ", ");
    }
    print("\n");

}

struct PQ_Node {
    uint32 node;
    float dist;
}

float[] dijkstra(Graph* g) {


    bool minheap_PQ_Node(PQ_Node[..] heap, uint32 l, r) {
        return heap[l].dist < heap[r].dist;
    }

    PQ_Node[..] heap = list_create(sizeof PQ_Node);
    PQ_Node first = {0, 0.0};
    heap_insert(*heap, *first, minheap_PQ_Node);

    uint32 node_count = list_length(g.nodes);
    float* dists = alloc float[node_count];
    for 0 .. node_count {
        dists[it] = Infinity;
    }

    dists[0] = 0.0;


    PQ_Node value = {};
    while heap_extract(heap, minheap_PQ_Node, *value) {
        Graph_Node node = g.nodes[value.node];

        if value.dist > dists[value.node]  continue;

        for node.start_edge .. node.start_edge + node.edges {
            Graph_Edge edge = g.edges[it];

            float d = dists[value.node] + edge.dist;
            if d < dists[edge.node] {
                dists[edge.node] = d;
                PQ_Node n = {edge.node, d};
                heap_insert(*heap, *n, minheap_PQ_Node);
            }
        }
    }

    list_delete(heap);

    return make_span(dists, node_count);
}